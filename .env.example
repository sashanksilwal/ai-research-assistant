# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
# Used when the main model is rate-limited or overloaded
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.6-flash
DATA_DIR=data
# Optional: contact email OpenAlex uses for faster service (citation graph)
# OPENALEX_EMAIL=
