# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is rate-limited or overloaded
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash
DATA_DIR=data
# Optional: contact email OpenAlex uses for faster service (citation graph)
# OPENALEX_EMAIL=
